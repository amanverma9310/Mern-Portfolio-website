# ==== Server ====
PORT=5000
NODE_ENV=development

# ==== Database ====
# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGO_URI=mongodb+srv://Amanvermav89900:Amanverma9900@cluster0.rvmvyac.mongodb.net/portfolio?appName=Cluster0
# ==== Auth ====
# Long random string used to sign JWTs. Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ==== Frontend origin (for CORS + cookie settings) ====
CLIENT_URL=http://localhost:5173

# ==== Initial admin account (used only by `npm run seed`) ====
# After seeding, change the password from the admin dashboard/DB — do not
# keep using this value long-term.
ADMIN_USERNAME=admin
ADMIN_EMAIL=amanverm9310@gmail.com
ADMIN_PASSWORD=Amanverma@1235

# ==== Email notifications (optional) ====
# If left blank, the contact form still saves messages to MongoDB —
# email notifications are just skipped.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
# Where the "new message" notification email should be sent
NOTIFY_EMAIL=amanverm9310@gmail.com
